# HTML immer frisch laden (Updates sofort sichtbar), Assets sind per ?v= versioniert
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

Options -Indexes

# www -> ohne www (eine kanonische Adresse für SEO)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.raphael-neuberger\.de$ [NC]
  RewriteRule ^(.*)$ https://raphael-neuberger.de/$1 [R=301,L]
</IfModule>
